{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "EventsPostgres": "Host=server;Port=5432;Database=events;use-secrets.json-to-set-username-and-password;Persist Security Info=True"
  },
  "Sieve": {
    "CaseSensitive": false,
    "DefaultPageSize": 50,
    "MaxPageSize": 200,
    "ThrowExceptions": true,
    "IgnoreNullsOnNotEqual": true,
    "DisableNullableTypeExpressionForSorting": false
  },
  "AllowedHosts": "*"
}
